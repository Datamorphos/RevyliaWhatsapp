# -------------------------------------------------------
# Revylia
# -------------------------------------------------------
REVYLIA_ENV=development
REVYLIA_CLINIC_ID=clinica-sonrisas
REVYLIA_CHANNEL=whatsapp
REVYLIA_MODEL=gemini-3.1-flash-lite
REVYLIA_MAX_INPUT_CHARS=4000
REVYLIA_MAX_AGENT_STEPS=2

GOOGLE_API_KEY=

# -------------------------------------------------------
# Supabase PostgreSQL
# Runtime serverless: Transaction Pooler (habitualmente :6543)
# -------------------------------------------------------
DATABASE_URL=

# Migraciones/setup: Direct connection o Session Pooler.
# Si queda vacío, setup_database.py usa DATABASE_URL.
DATABASE_URL_ADMIN=

# -------------------------------------------------------
# WhatsApp Cloud API / Meta
# -------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SEND_ENABLED=false

# Ejemplo conceptual: vXX.X. Usa la versión activa de tu app de Meta.
META_GRAPH_API_VERSION=
META_APP_SECRET=
VERIFY_META_SIGNATURE=false

# Opcional. Si se define, solo estos números pueden ejecutar agentes.
# Separar por comas, usando solo dígitos incluyendo indicativo de país.
WHATSAPP_ALLOWED_FROM_NUMBERS=

# -------------------------------------------------------
# Langfuse
# -------------------------------------------------------
REVYLIA_DISABLE_LANGFUSE=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
REVYLIA_TRACE_SAMPLING_RATE=1.0
REVYLIA_TRACE_CONTENT_MODE=masked
LANGFUSE_FLUSH_EACH_REQUEST=true
