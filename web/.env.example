# ---------------------------------------------------------------------------
# Panel Revylia — variables del frontend Next.js (§1 del contrato)
# Copia este archivo a `web/.env.local` y rellena los valores reales.
# Todos los valores de ejemplo son ficticios.
#
# `web/.gitignore` incluye la excepción `!.env.example`, así que este archivo
# SÍ se versiona. Nunca pongas aquí valores reales.
# ---------------------------------------------------------------------------

# ===========================================================================
# MODO DEMO (por defecto) — no requiere ninguna variable
# ===========================================================================
# Sin `PANEL_API_URL` el panel sirve los datos de `lib/demo/fixtures.ts`
# (meta.source = "demo:fixtures") y sin `PANEL_AUTH_ENABLED=true` no pide login.
# `pnpm dev` funciona tal cual, sin Supabase y sin base de datos.

# ===========================================================================
# MODO REAL — descomenta y rellena todo el bloque
# ===========================================================================

# --- Acceso (Supabase Auth) ------------------------------------------------
# Activa el guard del middleware. Obligatorio en cualquier entorno con datos
# reales: sin esto el panel queda abierto a cualquiera que llegue a la URL.
# PANEL_AUTH_ENABLED=true

# Proyecto Supabase. Solo la clave ANÓNIMA: nunca una `service_role` aquí.
# NEXT_PUBLIC_SUPABASE_URL=https://proyecto-ficticio.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.clave-anonima-ficticia

# Habilitación de cada usuario (§2): se concede desde la administración de
# Supabase escribiendo `app_metadata.revylia_panel = true`. NUNCA en
# `user_metadata`, que el propio usuario puede modificar.

# --- API del panel (FastAPI) ----------------------------------------------
# Puerto 8001: `uvicorn src.panel.app:app --port 8001`. NO es el 8000 del
# gateway de WhatsApp: el panel se despliega por separado.
# Solo se usa desde el servidor (sin prefijo NEXT_PUBLIC_): el navegador nunca
# ve esta URL ni llama al backend directamente.
# PANEL_API_URL=http://localhost:8001

# --- Copiloto --------------------------------------------------------------
# Endpoint AG-UI del agente de solo lectura. También es de servidor.
# Puerto 8123: `uvicorn src.panel_agent.server:app --port 8123`.
# Sin esta variable el copiloto sale en modo demostración (no conectado).
# AGENT_URL=http://localhost:8123/agent/revylia_panel

# ===========================================================================
# Backend (FastAPI) — NO van en este archivo
# ===========================================================================
# `PANEL_DATABASE_URL`, `REVYLIA_CLINIC_ID`, `SUPABASE_URL`,
# `SUPABASE_JWT_ISSUER` y `SUPABASE_JWKS_URL` viven en el `.env` de la raíz del
# repositorio. `clinic_id` se fija SIEMPRE en el servidor (§0.2): el frontend no
# lo envía nunca.
